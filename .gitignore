# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Environments ---
.venv/
venv/
env/

# --- Test / lint caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data ---
# Regenerable bulk stays out; the *deployed subset* is committed so a fresh
# clone and the Streamlit Cloud deployment both render the real application.
# See docs/ADR-004-commit-deployed-artifacts.md for the full rationale.
#
# NOTE: .gitignore has no inline comments — a '#' only starts a comment at
# the beginning of a line. Keep patterns bare.
#
# data/raw/ is 55MB and re-fetchable via `seismo data fetch`.
data/raw/
# data/export/ holds processed.csv at 141MB; GitHub rejects files over 100MB.
data/export/
# data/processed/ and data/features/ are intentionally NOT ignored.

# --- Model artifacts: regenerable, large ---
# Only the production model and the registry are committed; everything else
# is reproduced by `seismo model train --all`.
models/*
!models/registry.json
!models/xgboost/

# --- Runtime logs ---
reports/logs/

# --- Notebooks ---
notebooks/.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
